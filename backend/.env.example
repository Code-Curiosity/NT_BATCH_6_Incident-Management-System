# ========================================================
# INCIDENT MANAGEMENT SYSTEM - PANELISTS CONFIGURATION
# ========================================================

# [1] DATABASE CONFIGURATION
# --------------------------------------------------------
# For local localhost evaluations, SQLITE is completely sufficient 
# and will auto-generate the incidents.db file with zero setup needed!
DATABASE_URL=sqlite:///./incidents.db

# If you prefer to test against a strict MySQL 8.0 instance (e.g. Railway or PlanetScale):
# DATABASE_URL=mysql+pymysql://username:password@your-mysql-host.com:3306/incidents_db


# [2] GEMINI CLASSIFICATION ENGINE
# --------------------------------------------------------
# The system utilizes Gemini 1.5 Flash API as its primary routing and classification brain.
# Replace this with a valid API key to enable intelligent AI parsing. (A rule-based fallback exists)
GEMINI_API_KEY=your_gemini_api_key_here


# [3] APPLICATION SETTINGS
# --------------------------------------------------------
APP_ENV=development
DEBUG=true

# (Optional Notifications Support)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
